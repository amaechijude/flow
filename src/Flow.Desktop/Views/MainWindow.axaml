<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Flow.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="960"
        x:Class="Flow.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440" Height="960" MinWidth="1040" MinHeight="680"
        Title="Flow — Network Usage"
        Background="{DynamicResource FlowGroundBrush}">

    <Grid RowDefinitions="56,*">
        <!-- Top bar: brand, truthful daemon/IPC status, shared range + filter controls. -->
        <Border Grid.Row="0" Background="{DynamicResource FlowSurfaceBrush}"
                BorderBrush="{DynamicResource FlowBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource FlowPrimaryDeepBrush}" VerticalAlignment="Center">
                            <TextBlock Text="⧉" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FlowOnPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Flow" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Classes="pill" ToolTip.Tip="{Binding ProviderText}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding DaemonStateBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DaemonStateText}" FontFamily="{StaticResource FlowMonoFont}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding DaemonStateBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Classes="pill" ToolTip.Tip="{Binding SignalStatusText}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⇅" FontFamily="{StaticResource FlowMonoFont}" FontSize="11" Foreground="{DynamicResource FlowPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IpcText}" FontFamily="{StaticResource FlowMonoFont}" FontSize="10"
                                       Foreground="{DynamicResource FlowTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" MinWidth="148"
                              AutomationProperties.Name="Time range"
                              ToolTip.Tip="Rolling window or local calendar day; times are shown in local time">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RangeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding InterfaceFilters}" SelectedItem="{Binding SelectedInterfaceFilter}" MinWidth="176"
                              AutomationProperties.Name="Interface filter"
                              ToolTip.Tip="Filter summary, applications, processes and time series by interface">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:InterfaceFilterOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="⟳" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh data and daemon status"
                            ToolTip.Tip="Refresh real persisted data and daemon status" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" AutomationProperties.Name="Export current view as CSV"
                            ToolTip.Tip="Export the currently loaded view to CSV" />
                    <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" AutomationProperties.Name="Export current view as JSON"
                            ToolTip.Tip="Export the currently loaded view to JSON" />
                    <TextBlock Text="Loading…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"
                               Foreground="{DynamicResource FlowPrimaryBrush}" FontSize="12" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="232,*">
            <!-- Sidebar navigation + honest monitor summary. -->
            <Border Grid.Column="0" Background="{DynamicResource FlowSurfaceLowBrush}"
                    BorderBrush="{DynamicResource FlowBorderBrush}" BorderThickness="0,0,1,0" Padding="10">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="NAVIGATION" Classes="caps" Margin="10,8,0,6" />
                        <Button Classes="nav" Classes.active="{Binding IsOverviewActive}" Command="{Binding NavigateCommand}" CommandParameter="overview"
                                AutomationProperties.Name="Overview page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▦" FontSize="13" />
                                <TextBlock Text="Overview" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsApplicationsActive}" Command="{Binding NavigateCommand}" CommandParameter="applications"
                                AutomationProperties.Name="Apps and processes page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▤" FontSize="13" />
                                <TextBlock Text="Apps &amp; Processes" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsInterfacesActive}" Command="{Binding NavigateCommand}" CommandParameter="interfaces"
                                AutomationProperties.Name="Network interfaces page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⇄" FontSize="13" />
                                <TextBlock Text="Network Interfaces" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsDiagnosticsActive}" Command="{Binding NavigateCommand}" CommandParameter="diagnostics"
                                AutomationProperties.Name="Diagnostics and daemon page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⌗" FontSize="13" />
                                <TextBlock Text="Diagnostics &amp; Daemon" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsReportsActive}" Command="{Binding NavigateCommand}" CommandParameter="reports"
                                AutomationProperties.Name="Reports page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="▤" FontSize="13" />
                                <TextBlock Text="Reports" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsHistoryActive}" Command="{Binding NavigateCommand}" CommandParameter="history"
                                AutomationProperties.Name="History page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="◷" FontSize="13" />
                                <TextBlock Text="History" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateCommand}" CommandParameter="settings"
                                AutomationProperties.Name="Settings and provenance page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚙" FontSize="13" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsComparisonActive}" Command="{Binding NavigateCommand}" CommandParameter="comparison"
                                AutomationProperties.Name="Comparison page">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⇄" FontSize="13" />
                                <TextBlock Text="Comparison" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <Border Classes="card-tight" Background="{DynamicResource FlowCardBrush}">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="MONITOR" Classes="caps" />
                                    <TextBlock Grid.Column="1" Text="{Binding DaemonStateText}" FontFamily="{StaticResource FlowMonoFont}"
                                               FontSize="10" Foreground="{Binding DaemonStateBrush}" />
                                </Grid>
                                <Border Classes="divider" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Provider" Classes="caps" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProviderText}" Classes="mono" FontSize="10"
                                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Events" Classes="caps" />
                                    <TextBlock Grid.Column="1" Text="{Binding EventsText}" Classes="mono" FontSize="10" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Drop rate" Classes="caps" />
                                    <TextBlock Grid.Column="1" Text="{Binding DropRateText}" Classes="mono" FontSize="10" />
                                </Grid>
                                <Border Classes="divider" />
                                <TextBlock Text="Live values come from the daemon over D-Bus or from the same persisted SQLite data when IPC is unreachable."
                                           Classes="dim" FontSize="10" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastRefreshText}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: shared notice banner + current page. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" IsVisible="{Binding ShowDaemonNotice}" Margin="24,18,24,0" Padding="12,10"
                        Background="{DynamicResource FlowWarningSoftBrush}" BorderBrush="{DynamicResource FlowBorderStrongBrush}"
                        BorderThickness="1" CornerRadius="5">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠" Foreground="{DynamicResource FlowWarningBrush}" FontSize="15" VerticalAlignment="Top" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="ATTRIBUTION / CONNECTION NOTICE" Classes="caps" Foreground="{DynamicResource FlowWarningBrush}" />
                            <TextBlock Text="{Binding DaemonNoticeText}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,12,24,0" Spacing="8">
                    <Border IsVisible="{Binding IsCustomRange}" Background="{DynamicResource FlowCardBrush}"
                            BorderBrush="{DynamicResource FlowBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Custom range" Classes="caps" VerticalAlignment="Center" />
                            <TextBlock Text="From" Classes="muted" VerticalAlignment="Center" />
                            <DatePicker SelectedDate="{Binding CustomStartDate}" AutomationProperties.Name="Custom range start date" />
                            <TextBlock Text="To" Classes="muted" VerticalAlignment="Center" />
                            <DatePicker SelectedDate="{Binding CustomEndDate}" AutomationProperties.Name="Custom range end date" />
                            <Button Content="Apply" Classes="primary" Command="{Binding RefreshCommand}"
                                    AutomationProperties.Name="Apply custom range" />
                            <TextBlock Text="Local days → UTC buckets; display is local time." Classes="dim" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsComparisonActive}" Background="{DynamicResource FlowCardBrush}"
                            BorderBrush="{DynamicResource FlowBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Compare with" Classes="caps" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding ComparisonModes}" SelectedItem="{Binding SelectedComparisonMode}" MinWidth="160"
                                      AutomationProperties.Name="Comparison window mode"
                                      ToolTip.Tip="Choose the preceding window to compare against the current range" />
                            <TextBlock Text="The previous window uses the same granularity and interface filter." Classes="dim" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource FlowPrimarySoftBrush}" BorderBrush="{DynamicResource FlowBorderStrongBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <TextBlock Text="{Binding ExportStatus}" Classes="mono" Foreground="{DynamicResource FlowPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Padding="24,18,24,28" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
