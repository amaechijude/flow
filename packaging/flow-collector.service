[Unit]
Description=Flow privileged network usage collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0007
ExecStart=/usr/lib/flow/daemon/Flow.Daemon --Flow:Mode=collector --Flow:Monitor=ebpf --Flow:DatabasePath=/var/lib/flow/flow.db --Flow:Ebpf:LoaderPath=/usr/lib/flow/loader/flow_tcp_bytes_loader
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
# CAP_DAC_OVERRIDE is required: the unit restricts the bounding set, so root
# loses its normal ability to write files it does not own (e.g. a DB created
# by the user session daemon).
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
